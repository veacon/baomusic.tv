<?xml version="1.0" encoding="utf-8"?>
<!-- 浅蓝白渐变，与「宝听」蓝色音符 logo 同色系：近白(#F7FAFF) 左上 → 淡蓝(#E2EEFF) 右下。
     Visible only where the foreground PNG is transparent (outside the note / rings)，作为图标底色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#F7FAFF"
        android:centerColor="#EDF4FF"
        android:endColor="#E2EEFF"/>
</shape>
